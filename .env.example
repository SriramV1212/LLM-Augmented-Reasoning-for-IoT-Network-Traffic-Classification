# Optional — only for scripts/download_kaggle_data.py (not used by cli.py classify)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
# Prefer instead: ~/.kaggle/kaggle.json (chmod 600). Never commit real keys.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=tencent/hy3-preview:free
# OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,meta-llama/llama-3.1-70b-instruct

# LLM_AGENT_ML_CLASSIFIER=rf
# LLM_AGENT_CLASSIFY_MODE=ml_agent
#   ml_agent (default) — tree model + SHAP + optional LLM explainer
#   zeroshot — LLM-only classification (when supported by CLI defaults)
# Legacy: LLM_AGENT_TRACK_MODE=b|both maps to ml_agent; =a maps to zeroshot

# LLM_AGENT_MODELS_DIR=models
# LLM_AGENT_PROMPTS_DIR=prompts
